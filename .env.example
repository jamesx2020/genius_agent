# 填写密钥后重启服务。模型名可按你的 DeepSeek 账号实际可用模型修改。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MODEL_TEMPERATURE=0.1
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_TOKENS=4096
AGENT_RECURSION_LIMIT=80
AGENT_TASK_TIMEOUT_SECONDS=600
# 本机运行
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
COOKIE_SECURE=false
SESSION_HOURS=12
# 首次初始化时使用；修改后不会覆盖已创建账号的密码。
PM_PASSWORD=demo123
BUYER_PASSWORD=demo123
FINANCE_PASSWORD=demo123
MAX_UPLOAD_MB=10
